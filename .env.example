# Public site URL (used for newsletter confirm / unsubscribe links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SurrealDB — Surreal Cloud (WSS) or local Docker (HTTP RPC)
# Cloud example:
# SURREAL_URL="wss://xxxxx.aws-euw1.surreal.cloud"
# Local example:
# SURREAL_URL="http://127.0.0.1:8000/rpc"
SURREAL_URL="wss://syntix-platform-06f1eiv0r5vdhf5sddv4s10vec.aws-euw1.surreal.cloud"
SURREAL_NAMESPACE="okapi_edge_site"
SURREAL_DATABASE="okapi_edge_db"
SURREAL_USER="YOUR_SURREAL_CLOUD_USERNAME"
SURREAL_PASS="YOUR_SURREAL_CLOUD_PASSWORD"
# root | namespace | database — Surreal Cloud system users are usually "namespace"
SURREAL_AUTH_LEVEL="namespace"
SURREAL_PORT=8000

# Auth / back-office
AUTH_SECRET="replace-with-a-long-random-secret-key"
ADMIN_EMAIL="admin@okapiedge.com"
ADMIN_PASSWORD="ChangeMeNow!2026"
ADMIN_NAME="Okapi Owner"

# Newsletter (Resend) — required for confirm emails + campaign sending
# Create a key at https://resend.com/api-keys
# Verify your domain, then set NEWSLETTER_FROM to a verified address.
RESEND_API_KEY=""
NEWSLETTER_FROM="Okapi Edge <newsletter@okapiedge.com>"
